generator client {
  provider = "prisma-client-js"
}

model MusicianEquipmentOwned {
  id          String @id @default(cuid())
  musicianId  String
  equipmentId String
  quantity    Int    @default(1)
  notes       String @default("")

  musician  MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  equipment EquipmentItem   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([musicianId, equipmentId])
  @@index([equipmentId])
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  musician
  venue
  admin
}

enum CredentialType {
  degree
  certificate
  license
  award
}

enum BookingStatus {
  pending
  accepted
  declined
  completed
  cancelled
}

enum NegotiationStatus {
  none
  pending_response
  counter_pending
  expired
}
enum BookingSource {
  direct_request
  job_application
  project_application
  manual
}

enum PaymentStatus {
  pending
  authorized
  paid
  failed
  refunded
  partially_refunded
  cancelled
}

enum PaymentStructure {
  full_sum
  deposit_balance
  milestone
}

enum MilestoneStatus {
  pending
  submitted
  approved
  paid
}

enum DisputeKind {
  cancellation
  refund_request
}

enum DisputeTiming {
  pre_event
  post_event
}

enum DisputeStatus {
  pending_response
  accepted
  declined
  auto_resolved
  escalated
  resolved_refund_full
  resolved_refund_partial
  resolved_no_refund
}

enum DisputeInitiator {
  musician
  venue
}

enum PayoutStatus {
  pending
  scheduled
  paid
  failed
  cancelled
}

enum JobListingStatus {
  draft
  published
  paused
  closed
  filled
  expired
}

enum JobApplicationStatus {
  submitted
  shortlisted
  declined
  accepted
  withdrawn
}

enum PromotionPlacement {
  talent_search
  job_listing
  homepage_featured
  category_search
}

enum PromotionBillingModel {
  time_based
  view_based
}

enum PromotionStatus {
  draft
  scheduled
  active
  paused
  completed
  cancelled
}

enum AnalyticsEventType {
  profile_view
  search_impression
  search_click
  booking_request
  booking_accept
  booking_complete
  job_view
  job_apply
  promotion_view
  promotion_click
}

enum MusicSource {
  manual
  spotify
  apple_music
}

enum AuditLogLevel {
  debug
  info
  warn
  error
  critical
}

enum AuditEventCategory {
  auth
  authorization
  profile
  booking
  billing
  payment
  job
  promotion
  analytics
  integration
  system
  admin
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String?
  sessionVersion   Int       @default(0)
  image            String?
  role             UserRole  @default(musician)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime?
  termsAcceptedAt  DateTime?
  termsVersion     String?

  musicianProfile MusicianProfile?
  venueProfile    VenueProfile?
  accounts        Account[]
  sessions        Session[]
  reviews         Review[]
  auditLogs       AuditLog[] @relation("ActorAuditLogs")
  notificationPreference NotificationPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
  @@index([deletedAt])
}

model NotificationPreference {
  id                   String  @id @default(cuid())
  userId               String  @unique
  bookingRequests      Boolean @default(true)
  bookingUpdates       Boolean @default(true)
  newReviews           Boolean @default(true)
  jobAlerts            Boolean @default(true)
  marketingEmails      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

model MusicianProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  stageName       String
  bio             String  @default("") @db.Text
  experienceYears Int     @default(0)
  location        String  @default("")
  profileImage    String?
  bannerImage     String?
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  socialLinks     Json    @default("{}")
  instruments     String[] @default([])
  influences      String[] @default([])
  favorites       String[] @default([])
  performanceFee  Float?
  hourlyFee       Float?
  dayFee          Float?

  spotifyConnected    Boolean @default(false)
  spotifyAccessToken  String? @db.Text
  spotifyRefreshToken String? @db.Text
  appleMusicConnected Boolean @default(false)
  appleMusicToken     String? @db.Text

  stripeConnectAccountId  String?  @unique
  stripeOnboardingComplete Boolean @default(false)
  stripePayoutsEnabled    Boolean  @default(false)
  stripeCustomerId        String?  @unique

  mainGenreGroupId String?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainGenreGroup GenreGroup?      @relation(fields: [mainGenreGroupId], references: [id])
  genrePicks    MusicianGenreSubtypePick[]
  categoryPicks MusicianCategoryPick[]
  services      MusicianService[]
  albums     Album[]
  bookings   Booking[]
  reviews    Review[]
  jobApplications JobApplication[]
  projectApplications ProjectApplication[]
  payouts    Payout[]
  equipmentNeeds MusicianEquipmentNeed[]
  equipmentOwned MusicianEquipmentOwned[]
  credentials Credential[]
  availabilitySlots AvailabilitySlot[]
  conversationParticipants ConversationParticipant[]
  artistOpenCalls          ArtistOpenCall[]
  artistCallApplications   ArtistOpenCallApplication[]
  sentMessages             Message[]
  p2pQuestionnaireResponse P2PQuestionnaireResponse?
  p2pMatchesAsA            P2PMatch[] @relation("P2PMatchA")
  p2pMatchesAsB            P2PMatch[] @relation("P2PMatchB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageName])
  @@index([location])
  @@index([rating])
  @@index([mainGenreGroupId])
}

model Album {
  id          String      @id @default(cuid())
  musicianId  String
  title       String
  coverArt    String?
  releaseYear Int
  source      MusicSource @default(manual)
  externalId  String?
  externalUrl String?

  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  tracks   Track[]
  linkedServices MusicianService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([musicianId])
  @@index([source, externalId])
}

model Track {
  id          String  @id @default(cuid())
  albumId     String
  title       String
  duration    Int     @default(0)
  trackNumber Int     @default(1)
  previewUrl  String?
  genre       String?

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model VenueProfile {
  id           String  @id @default(cuid())
  userId       String  @unique
  venueName    String
  description  String  @default("") @db.Text
  location     String  @default("")
  capacity     Int     @default(0)
  venueType    String  @default("Other")
  profileImage String?
  bannerImage  String?

  clientType       String  @default("venue")
  membershipTierId String?
  stripeCustomerId String? @unique

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipTier MembershipTier? @relation(fields: [membershipTierId], references: [id])
  bookings       Booking[]
  jobListings    JobListing[]
  projectListings ProjectListing[]
  promotionCampaigns PromotionCampaign[]
  equipmentOfferings VenueEquipmentOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueName])
  @@index([location])
  @@index([membershipTierId])
  @@index([clientType])
}

model Booking {
  id                 String        @id @default(cuid())
  musicianId         String
  venueId            String
  jobApplicationId   String?       @unique
  projectApplicationId String?     @unique
  title              String        @default("Gig booking")
  eventType          String        @default("Live performance")
  eventDate          DateTime
  startTime          String
  endTime            String
  // Set only for project_application-sourced bookings — a deliverable due
  // date, not an in-person event time. eventDate/startTime/endTime still get
  // populated (deadline date, "00:00") so existing booking-list queries that
  // assume those fields are always set keep working unchanged.
  dueDate            DateTime?
  venueAddress       String        @default("")
  audienceSize       Int?
  loadInTime         String?
  soundcheckTime     String?
  setupNotes         String?       @db.Text
  requiredServices   Json          @default("[]")
  equipmentProvided  Json          @default("[]")
  hospitality        Json          @default("{}")
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  status             BookingStatus @default(pending)
  notes              String?       @db.Text
  fee                Float         @default(0)
  currency           String        @default("EUR")
  depositAmount      Float         @default(0)
  // How the agreed fee is collected. The amount fields below (platformFee*,
  // totalChargeAmount, netPayoutAmount) always describe the FIRST charge:
  // the whole fee for full_sum, the deposit portion for deposit_balance, and
  // nothing for milestone (each milestone is charged on approval). For
  // deposit_balance, depositAmount is the deposit portion of `fee`.
  paymentStructure   PaymentStructure @default(full_sum)
  balanceDueAt       DateTime?
  balanceChargedAt   DateTime?
  balanceFailedAt    DateTime?
  balancePaymentIntentId String?
  platformFeeRate    Float         @default(0.05)
  platformFeeAmount  Float         @default(0)
  processorFeeEstimate Float       @default(0)
  totalChargeAmount  Float         @default(0)
  netPayoutAmount    Float         @default(0)
  paymentStatus      PaymentStatus @default(pending)
  payoutStatus       PayoutStatus  @default(pending)
  cancellationPolicy String?       @db.Text
  source             BookingSource @default(direct_request)

  stripePaymentIntentId String?
  stripeCustomerId      String?
  stripePaymentMethodId String?
  stripeSetupIntentId   String?
  cancelledAt           DateTime?
  cancelledByUserId     String?

  negotiationStatus  NegotiationStatus @default(none)
  proposedFee        Float?
  proposedByUserId   String?
  responseDeadline   DateTime?
  payoutReleaseAt    DateTime?

  musician       MusicianProfile          @relation(fields: [musicianId], references: [id])
  venue          VenueProfile             @relation(fields: [venueId], references: [id])
  jobApplication JobApplication?          @relation(fields: [jobApplicationId], references: [id], onDelete: SetNull)
  projectApplication ProjectApplication?  @relation(fields: [projectApplicationId], references: [id], onDelete: SetNull)
  transactions   MarketplaceTransaction[]
  milestones     BookingMilestone[]
  disputes       BookingDispute[]
  review         Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([musicianId])
  @@index([venueId])
  @@index([status])
  @@index([eventDate])
  @@index([source])
  @@index([paymentStatus])
  @@index([payoutStatus])
}

model BookingDispute {
  id             String           @id @default(cuid())
  bookingId      String
  kind           DisputeKind
  timing         DisputeTiming
  status         DisputeStatus    @default(pending_response)
  initiatedBy    DisputeInitiator
  initiatorUserId String
  reason         String           @default("") @db.Text
  requestedRefundAmount Float?
  responseDeadline DateTime?
  respondedAt    DateTime?
  resolvedAt     DateTime?
  resolvedByUserId String?
  resolutionNotes String?         @db.Text

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([timing])
  @@index([responseDeadline])
}

model Review {
  id         String @id @default(cuid())
  bookingId  String @unique
  reviewerId String
  musicianId String
  rating     Int
  comment    String @default("") @db.Text

  booking  Booking         @relation(fields: [bookingId], references: [id])
  reviewer User            @relation(fields: [reviewerId], references: [id])
  musician MusicianProfile @relation(fields: [musicianId], references: [id])

  createdAt DateTime @default(now())

  @@index([reviewerId])
  @@index([musicianId])
  @@index([rating])
}

model MembershipTier {
  id       String @id @default(cuid())
  name     String @unique
  price    Float  @default(0)
  features Json   @default("[]")

  venues VenueProfile[]
}
model JobListing {
  id                    String           @id @default(cuid())
  venueId               String
  title                 String
  description           String           @default("") @db.Text
  eventType             String           @default("Live performance")
  eventDate             DateTime?
  startTime             String?
  endTime               String?
  timeZone              String           @default("Europe/Brussels")
  eventStartsAt         DateTime?
  eventEndsAt           DateTime?
  externalVenueName     String           @default("")
  stageSpecs            String           @default("") @db.Text
  useVenueEquipment     Boolean          @default(true)
  eventEquipment        Json             @default("[]")
  venueAddress          String           @default("")
  location              String           @default("")
  budgetMin             Float            @default(0)
  budgetMax             Float            @default(0)
  hideBudget            Boolean          @default(false)
  currency              String           @default("EUR")
  categories            Json             @default("[]")
  genres                Json             @default("[]")
  requiredServices      Json             @default("[]")
  equipmentProvided     Json             @default("[]")
  offeredPaymentStructures PaymentStructure[] @default([full_sum])
  depositPercent        Int              @default(30)
  applicationDeadline   DateTime?
  status                JobListingStatus @default(draft)
  isPromoted            Boolean          @default(false)
  visibilityScore       Float            @default(0)

  venue              VenueProfile        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  applications       JobApplication[]
  promotionCampaigns PromotionCampaign[]
  slots              JobListingSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([status])
  @@index([eventDate])
  @@index([applicationDeadline])
  @@index([isPromoted, visibilityScore])
}

model JobListingSlot {
  id           String  @id @default(cuid())
  jobListingId String
  label        String
  order        Int     @default(0)
  filled       Boolean @default(false)
  reservedByApplicationId String? @unique
  budgetMin    Float?
  budgetMax    Float?
  startTime    String?
  endTime      String?

  jobListing  JobListing       @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobListingId])
}

model JobApplication {
  id                String               @id @default(cuid())
  jobListingId      String
  musicianId        String
  slotId            String?
  coverMessage      String               @default("") @db.Text
  proposedFee       Float?
  availabilityNotes String?              @db.Text
  availabilityConfirmed Boolean          @default(false)
  paymentAttempt    Int                  @default(0)
  selectedPaymentStructure PaymentStructure @default(full_sum)
  proposedMilestones Json?
  status            JobApplicationStatus @default(submitted)

  jobListing JobListing      @relation(fields: [jobListingId], references: [id], onDelete: Cascade)
  musician   MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  slot       JobListingSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  booking    Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobListingId, musicianId])
  @@index([musicianId])
  @@index([status])
  @@index([createdAt])
  @@index([slotId])
}

// Deliverable-based work (a soundtrack, a video edit, a mix) — deadline
// instead of an event date/time, remote-friendly (no venue address
// required), single hire rather than a multi-slot lineup. Deliberately a
// separate model from JobListing/JobApplication rather than an "event vs
// project" mode on the same model, so each stays simpler and the event-only
// fields (startTime/endTime/venueAddress/slots) never need to be optional.
model ProjectListing {
  id                String               @id @default(cuid())
  venueId           String
  title             String
  description       String               @default("") @db.Text
  deadline          DateTime?
  budgetMin         Float                @default(0)
  budgetMax         Float                @default(0)
  hideBudget        Boolean              @default(false)
  currency          String               @default("EUR")
  categories        Json                 @default("[]")
  genres            Json                 @default("[]")
  requiredServices  Json                 @default("[]")
  offeredPaymentStructures PaymentStructure[] @default([full_sum])
  depositPercent    Int                  @default(30)
  status            JobListingStatus     @default(draft)

  venue        VenueProfile         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  applications ProjectApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([status])
  @@index([deadline])
}

model ProjectApplication {
  id           String               @id @default(cuid())
  projectListingId String
  musicianId   String
  coverMessage String               @default("") @db.Text
  proposedFee  Float?
  selectedPaymentStructure PaymentStructure @default(full_sum)
  proposedMilestones Json?
  status       JobApplicationStatus @default(submitted)

  projectListing ProjectListing  @relation(fields: [projectListingId], references: [id], onDelete: Cascade)
  musician       MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  booking        Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectListingId, musicianId])
  @@index([musicianId])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceTransaction {
  id                   String        @id @default(cuid())
  bookingId            String
  provider             String?
  providerPaymentId    String?
  // full | deposit | balance | milestone
  transactionType      String        @default("full")
  performanceFee       Float         @default(0)
  platformFeeRate      Float         @default(0.05)
  platformFeeAmount    Float         @default(0)
  processorFeeEstimate Float         @default(0)
  totalChargeAmount    Float         @default(0)
  artistPayoutAmount   Float         @default(0)
  currency             String        @default("EUR")
  status               PaymentStatus @default(pending)
  paidAt               DateTime?
  refundedAt           DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payouts Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([providerPaymentId])
  @@index([createdAt])
}

model Payout {
  id                 String       @id @default(cuid())
  transactionId      String
  musicianId         String
  providerPayoutId   String?
  amount             Float        @default(0)
  currency           String       @default("EUR")
  status             PayoutStatus @default(pending)
  scheduledFor       DateTime?
  paidAt             DateTime?

  transaction MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  musician    MusicianProfile        @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([transactionId])
  @@index([musicianId])
  @@index([status])
}

model PromotionPricingOption {
  id             String                @id @default(cuid())
  name           String
  placement      PromotionPlacement
  billingModel   PromotionBillingModel
  price          Float                 @default(0)
  currency       String                @default("EUR")
  durationDays   Int?
  includedViews  Int?
  description    String                @default("") @db.Text
  active         Boolean               @default(true)

  campaigns PromotionCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, billingModel])
  @@index([active])
}

model PromotionCampaign {
  id              String                @id @default(cuid())
  venueId         String
  jobListingId    String?
  pricingOptionId String?
  placement       PromotionPlacement
  billingModel    PromotionBillingModel
  status          PromotionStatus       @default(draft)
  budgetAmount    Float                 @default(0)
  spentAmount     Float                 @default(0)
  currency        String                @default("EUR")
  startsAt        DateTime
  endsAt          DateTime?
  viewLimit       Int?
  views           Int                   @default(0)
  clicks          Int                   @default(0)

  venue         VenueProfile            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  jobListing    JobListing?             @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  pricingOption PromotionPricingOption? @relation(fields: [pricingOptionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([jobListingId])
  @@index([placement, status])
  @@index([startsAt, endsAt])
}

model AnalyticsEvent {
  id                  String             @id @default(cuid())
  eventType           AnalyticsEventType
  actorUserId         String?
  musicianId          String?
  venueId             String?
  bookingId           String?
  jobListingId        String?
  promotionCampaignId String?
  metadata            Json?
  occurredAt          DateTime           @default(now())

  @@index([eventType])
  @@index([actorUserId])
  @@index([musicianId])
  @@index([venueId])
  @@index([bookingId])
  @@index([jobListingId])
  @@index([promotionCampaignId])
  @@index([occurredAt])
}

// ── Creative category hierarchy ──────────────────────────────
// 3 broad groups (Music & Audio Production, Film & Audiovisual
// Crew, Visual Artists & Creative Design) -> ~30 subcategories,
// one of which (Instrumentalist & Session Musician) has a further
// nested instrument-type level. A musician may pick up to 3
// subcategories PER broad group (enforced in Zod, not here).
model CategoryGroup {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  subcategories CategorySubtype[]

  @@index([slug])
}

model CategorySubtype {
  id      String @id @default(cuid())
  groupId String
  name    String
  slug    String @unique

  group           CategoryGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instrumentTypes InstrumentType[]
  picks           MusicianCategoryPick[]

  @@index([groupId])
}

model InstrumentType {
  id        String @id @default(cuid())
  subtypeId String
  name      String
  slug      String @unique

  subtype CategorySubtype        @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  picks   MusicianCategoryPick[]

  @@index([subtypeId])
}

model MusicianCategoryPick {
  id               String  @id @default(cuid())
  musicianId       String
  subtypeId        String
  instrumentTypeId String?

  musician       MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  subtype        CategorySubtype @relation(fields: [subtypeId], references: [id], onDelete: Cascade)
  instrumentType InstrumentType? @relation(fields: [instrumentTypeId], references: [id])

  @@unique([musicianId, subtypeId, instrumentTypeId])
  @@index([subtypeId])
}

// ── Genre hierarchy ───────────────────────────────────────────
// 9 broad groups (Rock, Electronic & Dance, Metal, Hip-Hop & Rap,
// Acoustic & Folk, Jazz, Fusion & Experimental, Soundtrack, Pop)
// each with specific subgenres + one "Other" free-text row. A
// musician picks exactly ONE main broad group (MusicianProfile.
// mainGenreGroupId), then 1-3 subgenres from within that group
// only (enforced in Zod, not here).
model GenreGroup {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  subgenres GenreSubtype[]
  musicians MusicianProfile[]

  @@index([slug])
}

model GenreSubtype {
  id      String  @id @default(cuid())
  groupId String
  name    String
  slug    String  @unique
  isOther Boolean @default(false)

  group GenreGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  picks MusicianGenreSubtypePick[]

  @@index([groupId])
}

model MusicianGenreSubtypePick {
  id          String  @id @default(cuid())
  musicianId  String
  subtypeId   String
  customLabel String?

  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  subtype  GenreSubtype    @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  @@unique([musicianId, subtypeId])
  @@index([subtypeId])
}

// Services a creative offers (session recording, mixing, filming, lessons,
// etc.) — distinct from genre/style and from CategoryGroup/CategorySubtype
// ("what kind of creative they are"). Applies to every profile type on
// MusicianProfile (musicians, DJs, voice actors, videographers, sound
// engineers, and so on).
model Service {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  icon String @default("")

  musicians MusicianService[]

  @@index([slug])
}

model MusicianService {
  id         String  @id @default(cuid())
  musicianId String
  serviceId  String
  portfolioAlbumId String?

  musician       MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  portfolioAlbum Album?          @relation(fields: [portfolioAlbumId], references: [id], onDelete: SetNull)

  @@unique([musicianId, serviceId])
  @@index([serviceId])
  @@index([portfolioAlbumId])
}

enum EquipmentKind {
  hardware
  software
}

enum EquipmentSource {
  custom
  shopify
  wikidata
}

// active: shown in pickers. pending: synced, awaiting admin approval.
// rejected: admin declined; syncs never resurrect it. hidden: admin hid an
// active item. retired: a sync no longer returns it. Retired/hidden items
// stay valid for existing selections but are not offered for new ones.
enum EquipmentStatus {
  active
  pending
  rejected
  hidden
  retired
}

model EquipmentItem {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  category    String          @default("Other")
  group       String          @default("other")
  kind        EquipmentKind   @default(hardware)
  source      EquipmentSource @default(custom)
  externalId  String?
  path        String          @default("")
  description String?
  status      EquipmentStatus @default(active)
  // Set when an admin edits name/category/group; syncs then leave those
  // fields alone.
  adminLocked   Boolean   @default(false)
  // Imported one-off by an admin rather than produced by a sync query, so a
  // sync never retires it for being absent from its results.
  addedManually Boolean   @default(false)
  lastSyncedAt  DateTime?

  musicianNeeds  MusicianEquipmentNeed[]
  venueOfferings VenueEquipmentOffering[]
  musicianOwned  MusicianEquipmentOwned[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([slug])
  @@index([category])
  @@index([group])
  @@index([status])
}

enum EquipmentSyncStatus {
  previewed
  applied
  failed
}

// A sync preview stores the exact validated candidate list so that applying
// it writes what the admin reviewed, not a fresh, unreviewed fetch.
model EquipmentSyncRun {
  id          String              @id @default(cuid())
  source      EquipmentSource
  status      EquipmentSyncStatus @default(previewed)
  version     String              @default("")
  candidates  Json                @default("[]")
  summary     Json                @default("{}")
  error       String?             @db.Text
  createdById String?
  appliedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

model MusicianEquipmentNeed {
  id          String  @id @default(cuid())
  musicianId  String
  equipmentId String
  quantity    Int     @default(1)
  notes       String  @default("")

  musician  MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)
  equipment EquipmentItem   @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([musicianId, equipmentId])
  @@index([equipmentId])
}

model VenueEquipmentOffering {
  id          String @id @default(cuid())
  venueId     String
  equipmentId String
  quantity    Int    @default(1)
  notes       String @default("")

  venue     VenueProfile  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  equipment EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([venueId, equipmentId])
  @@index([equipmentId])
}

model Credential {
  id         String         @id @default(cuid())
  musicianId String
  type       CredentialType
  title      String
  issuer     String         @default("")
  year       Int?

  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([musicianId])
  @@index([type])
}

model AvailabilitySlot {
  id         String   @id @default(cuid())
  musicianId String
  startDate  DateTime
  endDate    DateTime

  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([musicianId])
  @@index([startDate])
  @@index([endDate])
}

model AuditLog {
  id             String             @id @default(cuid())
  event          String
  category       AuditEventCategory
  level          AuditLogLevel      @default(info)
  actorUserId    String?
  actorEmailHash String?
  ipAddressHash  String?
  userAgent      String?            @db.Text
  requestId      String?
  targetType     String?
  targetId       String?
  metadata       Json?
  occurredAt     DateTime           @default(now())
  expiresAt      DateTime

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([category])
  @@index([level])
  @@index([actorUserId])
  @@index([requestId])
  @@index([occurredAt])
  @@index([expiresAt])
}

// ── P2P chat substrate (Phase 1) ─────────────────────────────
enum ConversationKind {
  p2p_match
  open_call
}

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind @default(p2p_match)
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]
  match        P2PMatch?
  artistCallApplication ArtistOpenCallApplication?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  musicianId     String
  lastReadAt     DateTime?

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  musician     MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([conversationId, musicianId])
  @@index([musicianId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       MusicianProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ── P2P Collaboration system (Phase 3) ───────────────────────
model P2PQuestionnaireResponse {
  id          String    @id @default(cuid())
  musicianId  String    @unique
  answers     Json      @default("{}")
  completedAt DateTime?

  musician MusicianProfile @relation(fields: [musicianId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum P2PMatchStatus {
  pending
  mutual
  declined
}

model P2PMatch {
  id             String         @id @default(cuid())
  musicianAId    String
  musicianBId    String
  initiatedBy    String
  status         P2PMatchStatus @default(pending)
  respondedAt    DateTime?
  conversationId String?        @unique

  musicianA    MusicianProfile @relation("P2PMatchA", fields: [musicianAId], references: [id], onDelete: Cascade)
  musicianB    MusicianProfile @relation("P2PMatchB", fields: [musicianBId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  deals        P2PDeal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([musicianAId, musicianBId])
  @@index([musicianBId])
  @@index([status])
}

enum P2PDealType {
  flat_fee
  milestone
  split_50_50
}

enum P2PDealStatus {
  proposed
  accepted
  declined
  in_progress
  completed
  cancelled
}

model P2PDeal {
  id          String        @id @default(cuid())
  matchId     String
  proposedBy  String
  payerId     String?
  payeeId     String?
  dealType    P2PDealType
  status      P2PDealStatus @default(proposed)
  title       String
  description String        @default("") @db.Text
  rateBasis   String?
  rateAmount  Float?
  currency    String        @default("EUR")

  stripePaymentIntentId String?
  stripeTransferId      String?
  paidAt                DateTime?

  match      P2PMatch       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  milestones P2PMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([status])
}

enum P2PMilestoneStatus {
  pending
  submitted
  approved
  paid
}

model P2PMilestone {
  id          String             @id @default(cuid())
  dealId      String
  label       String
  amount      Float
  order       Int                @default(0)
  status      P2PMilestoneStatus @default(pending)
  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  deal P2PDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ── Artist-posted open calls ─────────────────────────────────
enum ArtistCallDealType {
  rate
  milestone
  split_credit
}

model ArtistOpenCall {
  id          String             @id @default(cuid())
  posterId    String
  title       String
  roleSlug    String
  genreSlug   String?
  timeline    String
  dealType    ArtistCallDealType
  dealDetails String             @default("")
  description String             @default("") @db.Text
  status      JobListingStatus   @default(published)

  poster       MusicianProfile              @relation(fields: [posterId], references: [id], onDelete: Cascade)
  applications ArtistOpenCallApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([posterId])
  @@index([status, createdAt])
  @@index([roleSlug])
}

model ArtistOpenCallApplication {
  id             String  @id @default(cuid())
  callId         String
  applicantId    String
  conversationId String? @unique

  call         ArtistOpenCall  @relation(fields: [callId], references: [id], onDelete: Cascade)
  applicant    MusicianProfile @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  conversation Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([callId, applicantId])
  @@index([applicantId])
}

// Card fingerprints let P2P payments detect a card that also pays for venue
// accounts, so cash collaboration deals can't be used to dodge the full fee.
model CardFingerprint {
  id          String   @id @default(cuid())
  fingerprint String
  userId      String
  ownerRole   UserRole
  createdAt   DateTime @default(now())

  @@unique([fingerprint, userId])
  @@index([fingerprint])
  @@index([userId])
}

// Milestone-paid marketplace bookings: each milestone is charged and
// transferred when the client approves it (see api/bookings/[id]/milestones).
model BookingMilestone {
  id        String          @id @default(cuid())
  bookingId String
  label     String
  amount    Float
  order     Int             @default(0)
  status    MilestoneStatus @default(pending)
  stripePaymentIntentId String?
  submittedAt DateTime?
  approvedAt  DateTime?
  paidAt      DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
}
