# Supabase Postgres
# Runtime connection string from Supabase Transaction Pooler.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=""

# Direct connection string from Supabase Database Settings.
# Prisma migrations should use this, not the pooled URL.
# Example shape:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DIRECT_URL=""

# Supabase client values for future storage/realtime/client-side features
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Auth.js / NextAuth
# Generate with: npx auth secret
AUTH_URL="http://localhost:3000"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
AUTH_MAX_FAILED_LOGIN_ATTEMPTS="5"
AUTH_LOCKOUT_MINUTES="15"

# OAuth login providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Spotify OAuth (for artist discography import)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Apple Music (for artist discography import)
APPLE_MUSIC_KEY_ID=""
APPLE_MUSIC_TEAM_ID=""
APPLE_MUSIC_PRIVATE_KEY=""

# Structured logging
LOG_LEVEL="debug"
LOG_SALT=""

# Audit log retention windows
AUDIT_AUTH_RETENTION_DAYS="180"
AUDIT_AUTHZ_RETENTION_DAYS="180"
AUDIT_BUSINESS_RETENTION_DAYS="365"
AUDIT_SYSTEM_RETENTION_DAYS="365"
AUDIT_CRITICAL_RETENTION_DAYS="730"
